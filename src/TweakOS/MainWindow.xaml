<Window x:Class="TweakOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TweakOS"
        Width="1100" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="Page" Color="#090A10"/>
        <SolidColorBrush x:Key="Sidebar" Color="#0C0D14"/>
        <SolidColorBrush x:Key="Card" Color="#0E0F17"/>
        <SolidColorBrush x:Key="CardHover" Color="#151321"/>
        <SolidColorBrush x:Key="Border" Color="#242431"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#1A1B25"/>
        <SolidColorBrush x:Key="Text" Color="#F7F7FB"/>
        <SolidColorBrush x:Key="Muted" Color="#777887"/>
        <SolidColorBrush x:Key="Muted2" Color="#555663"/>
        <SolidColorBrush x:Key="Purple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="PurpleDark" Color="#24173D"/>
        <SolidColorBrush x:Key="Blue" Color="#6C73FF"/>
        <SolidColorBrush x:Key="Green" Color="#36E29B"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777887"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#12131C"/>
                                <Setter Property="Foreground" Value="#B7B2C5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Background" Value="#0E0F17"/>
            <Setter Property="Foreground" Value="#A4A4B2"/>
            <Setter Property="BorderBrush" Value="#242431"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CatBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CatBorder" Property="Background" Value="#151321"/>
                                <Setter TargetName="CatBorder" Property="BorderBrush" Value="#46356B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Background" Value="#8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RunBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RunBorder" Property="Background" Value="#A274FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RunBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Page}" BorderBrush="#2A2935" BorderThickness="1" CornerRadius="18" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Website-style top bar -->
            <Border Grid.Row="0" Background="#0B0C13" BorderBrush="#1B1C25" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="17,0,18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="31" Height="31" Background="#7655EE" CornerRadius="8">
                            <TextBlock Text="T" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TweakOS" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Performance Center" Foreground="#666775" FontSize="8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="#3E3F49" Margin="0,0,7,0"/>
                        <Ellipse Width="4" Height="4" Fill="#3E3F49" Margin="0,0,7,0"/>
                        <Ellipse Width="4" Height="4" Fill="#3E3F49"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Website sidebar -->
                <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#1B1C25" BorderThickness="0,0,1,0" CornerRadius="0,0,0,18">
                    <Grid Margin="11,20,10,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#24173D" BorderBrush="#8B5CF6" BorderThickness="2,0,0,0" CornerRadius="9" Padding="11,10" Margin="0,0,0,16">
                            <Button Content="◆ Dashboard" Foreground="White" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0" Click="Dashboard_Click" Cursor="Hand"/>
                        </Border>

                        <StackPanel Grid.Row="1">
                            <Button Content="ϟ  Tweaks" Style="{StaticResource NavButton}" Click="Tweaks_Click"/>
                            <Button Content="⊙  Performance" Style="{StaticResource NavButton}" Click="Performance_Click"/>
                            <Button Content="⚙  Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                        </StackPanel>

                        <Border Grid.Row="3" Background="Transparent" Padding="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="SYSTEM READY" Foreground="{StaticResource Green}" FontSize="8" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main content -->
                <Grid Grid.Column="1" Margin="28,28,28,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,21">
                        <TextBlock Text="PERFORMANCE CENTER" Foreground="#777887" FontSize="9" FontWeight="Bold" CharacterSpacing="160"/>
                        <TextBlock Text="System optimized." Foreground="White" FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- Dashboard -->
                        <Grid x:Name="DashboardPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="174"/>
                                <RowDefinition Height="88"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="13" Padding="19">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="System Performance" Foreground="#777887" FontSize="9" Grid.Row="0"/>
                                    <TextBlock Text="OPTIMIZED" Foreground="{StaticResource Green}" FontSize="8" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Right"/>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="98" Foreground="White" FontSize="50" FontWeight="Bold" LineHeight="50"/>
                                        <TextBlock Text="%" Foreground="{StaticResource Purple}" FontSize="15" FontWeight="Bold" VerticalAlignment="Bottom" Margin="3,0,0,8"/>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                        <Grid Height="5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="98*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" Background="#20212B" CornerRadius="3"/>
                                            <Border Grid.Column="0" Background="#8461F5" CornerRadius="3"/>
                                        </Grid>
                                        <Grid Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="CPU 34%" Foreground="#555663" FontSize="8"/>
                                            <TextBlock Grid.Column="1" Text="RAM 42%" Foreground="#555663" FontSize="8" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="GPU 61%" Foreground="#555663" FontSize="8" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="11" Margin="0,0,6,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="ϟ" Foreground="#F6A23A" FontSize="14"/>
                                        <TextBlock Text="GAMING" Foreground="#666775" FontSize="7" Margin="0,4,0,0"/>
                                        <TextBlock Text="OPTIMIZED" Foreground="White" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="11" Margin="3,0,3,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="◇" Foreground="{StaticResource Purple}" FontSize="14"/>
                                        <TextBlock Text="INPUT" Foreground="#666775" FontSize="7" Margin="0,4,0,0"/>
                                        <TextBlock Text="ENHANCED" Foreground="White" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="11" Margin="6,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="✦" Foreground="{StaticResource Purple}" FontSize="14"/>
                                        <TextBlock Text="SYSTEM" Foreground="#666775" FontSize="7" Margin="0,4,0,0"/>
                                        <TextBlock Text="CLEAN" Foreground="White" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,9,0,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE SYSTEM" Foreground="#777887" FontSize="8" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="CPU" Foreground="#555663" FontSize="8"/>
                                        <TextBlock x:Name="CpuValue" Text="--%" Foreground="White" FontSize="8" Margin="5,0,22,0"/>
                                        <TextBlock Text="RAM" Foreground="#555663" FontSize="8"/>
                                        <TextBlock x:Name="RamValue" Text="--%" Foreground="White" FontSize="8" Margin="5,0,22,0"/>
                                        <TextBlock Text="STATUS" Foreground="#555663" FontSize="8"/>
                                        <TextBlock Text="READY" Foreground="{StaticResource Green}" FontSize="8" FontWeight="Bold" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tweak Center -->
                        <Grid x:Name="TweaksPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="TWEAK CENTER" Foreground="#777887" FontSize="9" FontWeight="Bold" CharacterSpacing="130"/>
                                <TextBlock Text="Tune your system." Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,7,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,17,0,12">
                                <Button Content="ϟ  FPS Tweaks" Tag="FPS Tweaks" Style="{StaticResource CategoryButton}" Click="Category_Click"/>
                                <Button Content="◇  Network" Tag="Network" Style="{StaticResource CategoryButton}" Click="Category_Click"/>
                                <Button Content="✦  Clearen" Tag="Clearen" Style="{StaticResource CategoryButton}" Click="Category_Click"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBox x:Name="SearchBox" Background="#0E0F17" Foreground="White" BorderBrush="#242431" BorderThickness="1" Padding="11,8" TextChanged="SearchBox_TextChanged"/>
                                <ListView x:Name="TweakList" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#666775" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="RUN" Tag="{Binding}" Click="Run_Click" Style="{StaticResource RunButton}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>

                        <!-- Performance -->
                        <Grid x:Name="PerformancePanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="PERFORMANCE" Foreground="#777887" FontSize="9" FontWeight="Bold" CharacterSpacing="130"/>
                                <TextBlock Text="Live system metrics." Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,7,0,17"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,7,0">
                                        <StackPanel><TextBlock Text="CPU" Foreground="#777887" FontSize="9"/><TextBlock x:Name="CpuPerformanceValue" Text="--%" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock Text="Usage" Foreground="#555663" FontSize="9"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="3,0,3,0">
                                        <StackPanel><TextBlock Text="MEMORY" Foreground="#777887" FontSize="9"/><TextBlock x:Name="RamPerformanceValue" Text="--%" Foreground="White" FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock Text="RAM Usage" Foreground="#555663" FontSize="9"/></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="7,0,0,0">
                                        <StackPanel><TextBlock Text="STATUS" Foreground="#777887" FontSize="9"/><TextBlock Text="READY" Foreground="{StaticResource Green}" FontSize="28" FontWeight="Bold" Margin="0,14,0,0"/><TextBlock Text="System optimized" Foreground="#555663" FontSize="9"/></StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Settings -->
                        <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="SETTINGS" Foreground="#777887" FontSize="9" FontWeight="Bold" CharacterSpacing="130"/>
                                <TextBlock Text="TweakOS preferences." Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,7,0,17"/>
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Application" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Keep TweakOS visually aligned with the Performance Center design." Foreground="#666775" FontSize="9" Margin="0,5,0,17"/>
                                        <Button Content="Check for Updates" Width="145" HorizontalAlignment="Left" Style="{StaticResource RunButton}" Click="Update_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
