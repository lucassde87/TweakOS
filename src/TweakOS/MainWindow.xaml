<Window x:Class="TweakOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TweakOS"
        Width="1280"
        Height="760"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#070B12">

    <Window.Resources>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AEB8C8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#171F2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#273348"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#0B1019"
                BorderBrush="#151E2D"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Margin="8,10,8,28">

                    <TextBlock Text="TweakOS"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="by Damon"
                               Foreground="#66758C"
                               FontSize="12"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <!-- STATUS -->
                <Border Grid.Row="1"
                        Background="#101824"
                        BorderBrush="#1C293A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="●  SYSTEM READY"
                                   Foreground="#55D98B"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="TweakOS 5.0"
                                   Foreground="#6E7E94"
                                   FontSize="11"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                <!-- NAVIGATION -->
                <StackPanel Grid.Row="2">

                    <Button x:Name="DashboardButton"
                            Content="▣   Dashboard"
                            Style="{StaticResource NavButton}"
                            Click="Dashboard_Click"/>

                    <Button x:Name="TweaksButton"
                            Content="⚡   Tweaks"
                            Style="{StaticResource NavButton}"
                            Click="Tweaks_Click"/>

                    <Button x:Name="PerformanceButton"
                            Content="◉   Performance"
                            Style="{StaticResource NavButton}"
                            Click="Performance_Click"/>

                    <Button x:Name="SettingsButton"
                            Content="⚙   Settings"
                            Style="{StaticResource NavButton}"
                            Click="Settings_Click"/>

                </StackPanel>

                <!-- FOOTER -->
                <TextBlock Grid.Row="3"
                           Text="TweakOS Performance Center"
                           Foreground="#46556A"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="8,0,8,8"/>

            </Grid>

        </Border>


        <!-- MAIN AREA -->
        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  Margin="0,5,0,25">

                <StackPanel>

                    <TextBlock Text="PERFORMANCE CENTER"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"/>

                    <TextBlock Text="System optimized."
                               Foreground="#718096"
                               FontSize="13"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <Button Content="Check for Updates"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource ActionButton}"
                        Click="Update_Click"/>

            </Grid>


            <!-- DASHBOARD -->
            <Grid x:Name="DashboardPanel"
                  Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP CARDS -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- PERFORMANCE -->
                    <Border Grid.Column="0"
                            Background="#101722"
                            BorderBrush="#1B2738"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,12,0"
                            Padding="25">

                        <StackPanel>

                            <TextBlock Text="PERFORMANCE"
                                       Foreground="#728198"
                                       FontSize="11"
                                       FontWeight="Bold"/>

                            <TextBlock Text="98%"
                                       Foreground="White"
                                       FontSize="48"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"/>

                            <TextBlock Text="Gaming Optimized"
                                       Foreground="#55D98B"
                                       FontSize="13"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- CPU -->
                    <Border Grid.Column="1"
                            Background="#101722"
                            BorderBrush="#1B2738"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,12,0"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="CPU"
                                       Foreground="#728198"
                                       FontSize="11"/>

                            <TextBlock x:Name="CpuValue"
                                       Text="--%"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,15,0,0"/>

                            <TextBlock Text="Usage"
                                       Foreground="#5F6D80"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>


                    <!-- RAM -->
                    <Border Grid.Column="2"
                            Background="#101722"
                            BorderBrush="#1B2738"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>

                            <TextBlock Text="MEMORY"
                                       Foreground="#728198"
                                       FontSize="11"/>

                            <TextBlock x:Name="RamValue"
                                       Text="--%"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,15,0,0"/>

                            <TextBlock Text="RAM Usage"
                                       Foreground="#5F6D80"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- STATUS -->
                <Border Grid.Row="1"
                        Background="#101722"
                        BorderBrush="#1B2738"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,15,0,0"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="SYSTEM STATUS"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"/>

                        <Grid Margin="0,25,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="✓"
                                           Foreground="#55D98B"
                                           FontSize="24"/>
                                <TextBlock Text="Gaming Optimized"
                                           Foreground="#C7D0DD"
                                           FontSize="13"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Performance tweaks active"
                                           Foreground="#59687B"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="✓"
                                           Foreground="#55D98B"
                                           FontSize="24"/>
                                <TextBlock Text="Input Enhanced"
                                           Foreground="#C7D0DD"
                                           FontSize="13"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="Input latency optimized"
                                           Foreground="#59687B"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="✓"
                                           Foreground="#55D98B"
                                           FontSize="24"/>
                                <TextBlock Text="System Clean"
                                           Foreground="#C7D0DD"
                                           FontSize="13"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="System ready for gaming"
                                           Foreground="#59687B"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- TWEAKS -->
            <Grid x:Name="TweaksPanel"
                  Grid.Row="1"
                  Visibility="Collapsed">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             Height="40"
                             Background="#101722"
                             Foreground="White"
                             BorderBrush="#253348"
                             BorderThickness="1"
                             Padding="12"
                             TextChanged="SearchBox_TextChanged"/>

                    <ListView x:Name="TweakList"
                              Grid.Row="1"
                              Margin="0,15,0,0"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border Background="#101722"
                                        BorderBrush="#1B2738"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="15"
                                        Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="#68778B"
                                                       FontSize="11"
                                                       Margin="0,4,0,0"/>

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="RUN"
                                                Tag="{Binding}"
                                                Click="Run_Click"
                                                Style="{StaticResource ActionButton}"
                                                Padding="20,8"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Grid>


            <!-- PERFORMANCE -->
            <Grid x:Name="PerformancePanel"
                  Grid.Row="1"
                  Visibility="Collapsed">

                <StackPanel>

                    <Border Background="#101722"
                            BorderBrush="#1B2738"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock Text="CPU USAGE"
                                       Foreground="#718096"
                                       FontSize="11"/>

                            <TextBlock x:Name="CpuPerformanceValue"
                                       Text="--%"
                                       Foreground="White"
                                       FontSize="42"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#101722"
                            BorderBrush="#1B2738"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25">

                        <StackPanel>

                            <TextBlock Text="MEMORY USAGE"
                                       Foreground="#718096"
                                       FontSize="11"/>

                            <TextBlock x:Name="RamPerformanceValue"
                                       Text="--%"
                                       Foreground="White"
                                       FontSize="42"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- SETTINGS -->
            <Grid x:Name="SettingsPanel"
                  Grid.Row="1"
                  Visibility="Collapsed">

                <StackPanel>

                    <Border Background="#101722"
                            BorderBrush="#1B2738"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="25">

                        <StackPanel>

                            <TextBlock Text="TweakOS Settings"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Version 5.0.2"
                                       Foreground="#68778B"
                                       FontSize="12"
                                       Margin="0,10,0,20"/>

                            <Button Content="Check for Updates"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ActionButton}"
                                    Click="Update_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
