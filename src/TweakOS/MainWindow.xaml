<Window x:Class="TweakOS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TweakOS" Height="720" Width="1180" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#0b0f14">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="TweakOS" FontSize="34" FontWeight="Bold" Foreground="White"/><TextBlock Text="Windows Performance &amp; Optimization" Foreground="#8e9aaa"/></StackPanel>
<StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="VersionText" Text="v5.0.0" Foreground="#8e9aaa" VerticalAlignment="Center" Margin="0,0,14,0"/><Button x:Name="UpdateButton" Content="Nach Updates suchen" Click="Update_Click" Padding="14,8" Background="#1d2733" Foreground="White" BorderThickness="0"/></StackPanel></Grid>
<Border Grid.Row="1" Margin="0,18,0,16" Padding="14" Background="#111820" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Tweak-Datenbank" Foreground="White" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="CatalogStatus" Text="Wird geladen..." Foreground="#8e9aaa"/></StackPanel>
<TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center" Padding="10" Background="#0b0f14" Foreground="White" BorderBrush="#293544"/></Grid></Border>
<ListView Grid.Row="2" x:Name="TweakList" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate>
<Border Margin="0,0,0,10" Padding="16" Background="#111820" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
<StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White"/><Border Margin="10,0,0,0" Padding="7,2" Background="#1d2733" CornerRadius="5"><TextBlock Text="{Binding Category}" Foreground="#aeb8c4" FontSize="11"/></Border></StackPanel>
<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#9ba7b5"/><TextBlock Text="{Binding ReviewStatus}" Margin="0,6,0,0" Foreground="#d49b55" FontSize="11"/></StackPanel>
<TextBlock Grid.Column="1" Text="{Binding Risk}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#e0a35a"/>
<Button Grid.Column="2" Content="Ausführen" Click="Run_Click" Tag="{Binding}" Height="38" Margin="8,0,0,0" Background="#263545" Foreground="White" BorderThickness="0"/></Grid></Border>
</DataTemplate></ListView.ItemTemplate></ListView>
<TextBlock Grid.Row="3" Margin="0,14,0,0" Foreground="#6f7c8b" Text="TweakOS führt Änderungen nur nach deiner Bestätigung aus. Kritische/ungeprüfte Tweaks bleiben gekennzeichnet."/>
</Grid></Window>