<Window x:Class="TweakOS.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="TweakOS"
     Height="760"
     Width="1280"
     MinHeight="650"
     MinWidth="1050"
     WindowStartupLocation="CenterScreen"
     Background="#070B12">

```
<Window.Resources>

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8994A6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="18,13"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="#7C3AED"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#0D131D"/>
        <Setter Property="BorderBrush" Value="#192333"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

</Window.Resources>

<Grid>

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="235"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- SIDEBAR -->

    <Border Grid.Column="0"
            Background="#090E16"
            BorderBrush="#151D2A"
            BorderThickness="0,0,1,0">

        <Grid Margin="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LOGO -->

            <StackPanel>

                <TextBlock Text="TweakOS"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="by Damon"
                           Margin="2,2,0,0"
                           FontSize="12"
                           Foreground="#7C3AED"/>

            </StackPanel>

            <!-- NAVIGATION -->

            <StackPanel Grid.Row="1"
                        Margin="0,55,0,0">

                <TextBlock Text="MAIN"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#4F5B6C"
                           Margin="18,0,0,10"/>

                <Button Content="▣   Dashboard"
                        Style="{StaticResource NavButton}"
                        Click="Dashboard_Click"/>

                <Button Content="⚡   Tweaks"
                        Style="{StaticResource NavButton}"
                        Click="Tweaks_Click"/>

                <Button Content="◉   Performance"
                        Style="{StaticResource NavButton}"
                        Click="Performance_Click"/>

                <Button Content="⚙   Settings"
                        Style="{StaticResource NavButton}"
                        Click="Settings_Click"/>

            </StackPanel>

            <!-- STATUS -->

            <Border Grid.Row="2"
                    Background="#0D131D"
                    BorderBrush="#192333"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="#22C55E"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="SYSTEM READY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#22C55E"/>

                    </StackPanel>

                    <TextBlock x:Name="VersionText"
                               Text="v5.0.2"
                               Margin="16,6,0,0"
                               Foreground="#687587"
                               FontSize="11"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

    <!-- MAIN AREA -->

    <Grid Grid.Column="1"
          Margin="34">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Grid>

            <StackPanel>

                <TextBlock x:Name="PageTitle"
                           Text="Performance Center"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="PageSubtitle"
                           Text="System optimized."
                           Margin="0,5,0,0"
                           Foreground="#788598"
                           FontSize="14"/>

            </StackPanel>

            <Button x:Name="UpdateButton"
                    Content="Nach Updates suchen"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource ActionButton}"
                    Click="Update_Click"/>

        </Grid>

        <!-- CONTENT -->

        <Grid Grid.Row="1"
              Margin="0,30,0,0">

            <!-- DASHBOARD -->

            <Grid x:Name="DashboardPanel">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- OPTIMIZATION -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}"
                            Padding="24"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="PERFORMANCE"
                                       Foreground="#687587"
                                       FontSize="10"
                                       FontWeight="Bold"/>

                            <TextBlock Text="98%"
                                       Margin="0,7,0,0"
                                       Foreground="White"
                                       FontSize="40"
                                       FontWeight="Bold"/>

                            <TextBlock Text="System optimized."
                                       Foreground="#22C55E"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource Card}"
                            Padding="22"
                            Margin="10,0">

                        <StackPanel>

                            <TextBlock Text="CPU"
                                       Foreground="#687587"
                                       FontSize="11"/>

                            <TextBlock x:Name="CpuText"
                                       Text="--%"
                                       Margin="0,7,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Intel Processor"
                                       Foreground="#687587"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource Card}"
                            Padding="22"
                            Margin="10,0,0,0">

                        <StackPanel>

                            <TextBlock Text="MEMORY"
                                       Foreground="#687587"
                                       FontSize="11"/>

                            <TextBlock x:Name="RamText"
                                       Text="--%"
                                       Margin="0,7,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="System RAM"
                                       Foreground="#687587"
                                       FontSize="11"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- STATUS CARDS -->

                <Grid Grid.Row="1"
                      Margin="0,22,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}"
                            Padding="24"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock Text="SYSTEM STATUS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#687587"/>

                            <TextBlock Text="✓  Gaming Optimized"
                                       Margin="0,22,0,0"
                                       Foreground="#22C55E"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="✓  Input Enhanced"
                                       Margin="0,16,0,0"
                                       Foreground="#22C55E"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="✓  System Clean"
                                       Margin="0,16,0,0"
                                       Foreground="#22C55E"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource Card}"
                            Padding="24"
                            Margin="10,0,0,0">

                        <StackPanel>

                            <TextBlock Text="TWEAKOS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#687587"/>

                            <TextBlock Text="Performance Center"
                                       Margin="0,20,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="Optimize Windows for gaming and everyday performance."
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Foreground="#788598"
                                       FontSize="13"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

            <!-- TWEAKS -->

            <Grid x:Name="TweaksPanel"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}"
                        Padding="14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Tweak-Datenbank"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="16"/>

                            <TextBlock x:Name="CatalogStatus"
                                       Text="Wird geladen..."
                                       Foreground="#788598"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged"
                                 VerticalContentAlignment="Center"
                                 Padding="10"
                                 Background="#070B12"
                                 Foreground="White"
                                 BorderBrush="#253044"/>

                    </Grid>

                </Border>

                <ListView Grid.Row="1"
                          x:Name="TweakList"
                          Margin="0,18,0,0
```
